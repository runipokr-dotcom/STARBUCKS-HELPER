rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isServer3Owner() {
      return request.auth != null && request.auth.uid == 'DFtc3qItyZQYmE9m4q2JgXJyqrW2';
    }
    function isServer3Work(id) {
      return id == 'coupon-server-3' || id.matches('coupons3_json.*');
    }
    // Private card data: never accessible through anonymous authentication.
    match /privateCouponData/server3 {
      allow read, write: if isServer3Owner();
    }
    // Preserve unrelated LIVE behavior while securing server 3 first.
    // The live baseline on 2026-09-28 allowed all documents, unlike the old repo file.
    // Wider HELPER hardening remains a separate migration.
    match /{collection}/{documentId} {
      allow read, write: if collection != 'privateCouponData'
        && (collection != 'couponWork' || !isServer3Work(documentId) || isServer3Owner());
      match /{nested=**} {
        allow read, write: if collection != 'privateCouponData'
          && (collection != 'couponWork' || !isServer3Work(documentId) || isServer3Owner());
      }
    }
  }
}
